generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  MANAGEMENT
  CASHIER
}

model User {
  id        String   @id @default(cuid())
  name      String
  email     String   @unique
  password  String
  image     String?  // URL or path to profile image
  role      Role     @default(CASHIER) // Default to lowest access
  createdAt DateTime @default(now())
  orders    Order[]
  auditLogs AuditLog[]
}

model Product {
  id          String      @id @default(cuid())
  name        String
  price       Decimal
  stock       Int
  barcode     String?     @unique
  category    String
  orderItems  OrderItem[]
  createdAt   DateTime    @default(now())
}

model Order {
  id          String      @id @default(cuid())
  totalAmount Decimal
  status      String      @default("COMPLETED")
  cashierId   String
  cashier     User        @relation(fields: [cashierId], references: [id])
  items       OrderItem[]
  createdAt   DateTime    @default(now())
  tableNumber Int?        // Assigned table number
  paymentMethod String    @default("CASH") // CASH, OVO, DANA, GOPAY, QR
}


model OrderItem {
  id        String   @id @default(cuid())
  orderId   String
  order     Order    @relation(fields: [orderId], references: [id])
  productId String?
  product   Product? @relation(fields: [productId], references: [id], onDelete: SetNull)
  productName String // Snapshot of product name at time of purchase
  quantity  Int
  price     Decimal
}


model AuditLog {
  id        String   @id @default(cuid())
  action    String   // LOGIN, LOGOUT, CREATE, UPDATE, DELETE
  entity    String   // USER, PRODUCT, ORDER, AUTH
  details   String?  // JSON string or description
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  createdAt DateTime @default(now())
}

model StoreSettings {
  id           Int    @id @default(1)
  storeName    String @default("Acme POS")
  storeAddress String @default("Jalan Raya No. 123, Jakarta")
  storePhone   String @default("021-12345678")
  storeEmail   String @default("admin@acme.com")
  storeFax     String?   @default("")
}

model LandingPage {
    id              Int      @id @default(autoincrement())
    heroTitle       String   @default("Welcome to Our POS System")
    heroDescription String   @default("The best solution for your business management.")
    heroImage       String   @default("/pos-tab.png")
    features        Json?    // Array of { title, description, icon }
    pricingPlans    Json?    // Array of { name, price, features, highlight, cta }
    updatedAt       DateTime @updatedAt
}